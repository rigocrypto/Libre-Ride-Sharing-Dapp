# fallback env template if .env.example blocked by git filters
#
# Copy to .env or .env.compose as needed.

NODE_ENV=development
PORT=5000
VITE_PORT=5173
STORAGE_ENGINE=drizzle
ENABLE_PAYMENTS=true
ENABLE_AA=true
ENABLE_PUSH=true
RETENTION_DAYS=730
PROTOCOL_FEE_BPS=300

DATABASE_URL=postgres://libre:libre@localhost:5432/libre
DB_POOL_SIZE=10
DB_SSL=false
REDIS_URL=redis://localhost:6379

UPLOADTHING_API_KEY=your-uploadthing-api-key
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOAD_MAX_MB=25

RESEND_API_KEY=your-resend-key
MAILHOG_SMTP=smtp://localhost:1025
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+14075550123
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key
ONESIGNAL_REST_URL=https://onesignal.com/api/v1
ONESIGNAL_MOCK_URL=http://localhost:5010/notifications

NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_ALCHEMY_BASE_RPC=https://base-sepolia.g.alchemy.com/v2/your-key
ALCHEMY_BASE_RPC=https://base-sepolia.g.alchemy.com/v2/your-key
USDC_CONTRACT_ADDRESS_TESTNET=0x1234567890abcdef1234567890abcdef12345678
PRIVATE_KEY_DEPLOYER=0xabc123...
NEXT_PUBLIC_FAKE_WALLET=0

OCR_PROVIDER=mock
OCR_WEBHOOK_SECRET=replace-me
AIRPORT_LICENSE_REQUIRED=true
VEHICLE_MAX_AGE_YEARS=15

NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_ONESIGNAL_APP_ID=${ONESIGNAL_APP_ID}
NEXT_PUBLIC_UPLOADTHING_KEY=${UPLOADTHING_API_KEY}

ENABLE_TELEMETRY=false
SENTRY_DSN=
LOG_LEVEL=debug





